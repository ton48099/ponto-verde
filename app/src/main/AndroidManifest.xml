<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Só para pedir ao sistema que não mate o copiloto para economizar bateria. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Vigia do copiloto: notificação com a hora da última oferta e aviso sonoro
         quando o leitor para de ler. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- O corretor opcional (NVIDIA Nemotron) precisa de rede. Nada é enviado
         enquanto a chave "Corretor IA" estiver desligada nas opções de
         desenvolvedor; sem API key configurada o app não abre conexão. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <package android:name="com.ubercab.driver" />
        <package android:name="com.app99.driver" />
        <package android:name="sinet.startup.indriver" />
        <package android:name="br.com.ifood.driver.app" />
        <package android:name="taxi.drivermachine" />
        <package android:name="br.com.tourmobilidade.prestador" />
    </queries>

    <application
        android:name=".PontoVerdeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Ponto Verde"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PontoVerde">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Acorda o app para avisar quando a última leitura ficou velha. -->
        <receiver
            android:name=".capture.VigiaRecebedor"
            android:exported="false" />

        <service
            android:name=".capture.LeitorDeOfertasService"
            android:exported="false"
            android:label="Ponto Verde — leitura de ofertas"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
