<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- O ML Kit declara INTERNET; removemos para que o app não tenha como sair da rede. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <queries>
        <package android:name="com.ubercab.driver" />
        <package android:name="com.app99.driver" />
        <package android:name="sinet.startup.indriver" />
        <package android:name="br.com.ifood.driver.app" />
        <package android:name="taxi.drivermachine" />
        <package android:name="br.com.tourmobilidade.prestador" />
    </queries>

    <application
        android:name=".PontoVerdeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Ponto Verde"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PontoVerde">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".capture.LeitorDeOfertasService"
            android:exported="false"
            android:label="Ponto Verde — leitura de ofertas"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
